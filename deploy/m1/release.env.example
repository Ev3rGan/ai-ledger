AI_INTEL_IMAGE=registry.example/ai-ledger@sha256:replace-with-image-digest
AI_INTEL_RELEASE=replace-with-git-commit-sha
AI_INTEL_RELEASE_DIR=/opt/ai-ledger/releases/replace-with-git-commit-sha
AI_INTEL_DOMAIN=ai.example.com
AI_INTEL_POSTGRES_DATABASE=ai_ledger
AI_INTEL_POSTGRES_USER=ai_ledger
AI_INTEL_SECRETS_DIR=/etc/ai-ledger-m1/secrets
AI_INTEL_BACKUP_DIR=/var/backups/ai-ledger-m1
AI_INTEL_OFFSITE_BACKUP_DIR=/mnt/ai-ledger-m1-offsite
AI_INTEL_ANONYMOUS_RESEARCH_DAILY_LIMIT=3
AI_INTEL_PROVIDER_MONTHLY_BUDGET_CENTS=10000
AI_INTEL_PROVIDER_REQUEST_RESERVATION_CENTS=100
AI_INTEL_SCHEDULE_BACKFILL_LIMIT=5
AI_INTEL_BACKUP_INTERVAL_SECONDS=86400
AI_INTEL_BACKUP_RETENTION_DAYS=14
